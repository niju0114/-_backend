# 이 파일을 복사해서 .env로 만들고 실제 값을 채워넣으세요.
# .env는 .gitignore에 의해 절대 Git에 올라가지 않습니다.

# 국토교통부 공공데이터포털 서비스키
MOLIT_API_KEY=

# 카카오 디벨로퍼스 REST API 키 (주소 정규화용, 지도 API 아님)
KAKAO_API_KEY=

# 한국부동산원 R-ONE(부동산통계정보시스템) 인증키
REB_API_KEY=

# KOSIS(국가통계포털) API 키 - 거시데이터 분기별 매매수급동향용
KOSIS_API_KEY=

# Supabase 프로젝트 정보
# 주의: 백엔드는 반드시 secret 키(sb_secret_...)를 써야 합니다.
# publishable 키(sb_publishable_...)는 프론트엔드용이라 권한이 제한되어
# 우리 배치 스크립트가 테이블에 쓰기 작업을 할 수 없습니다.
SUPABASE_URL=
SUPABASE_KEY=

# ORM(SQLAlchemy)이 DB에 직접 접속할 때 쓰는 연결 문자열 (위 SUPABASE_URL/KEY와는 다른 값)
# Supabase 대시보드 -> Project Settings -> Database -> Connection string(URI)에서 확인
# 형태: postgresql://postgres:[비밀번호]@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=

# Gemini API 키 (AI 브리핑용, 9/10 단계에서 사용)
GEMINI_API_KEY=
